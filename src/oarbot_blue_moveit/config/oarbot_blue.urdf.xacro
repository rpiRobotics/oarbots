<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="oarbot_blue">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import oarbot_blue urdf file -->
    <xacro:include filename="$(find oarbot_description)/urdf/oarbot_blue.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="oarbot_blue.ros2_control.xacro" />


    <xacro:oarbot_blue_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
