<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>force_torque_calibration</name>
  <version>0.0.0</version>
  <description>Provides calibration data for the Rokubi force torque sensor</description>
  <maintainer email="oconna4@rpi.edu">Aidan O'Connor</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>kinova_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
