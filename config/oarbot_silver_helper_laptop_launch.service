[Unit]
Description=Launch OARBot Silver ROS2 Nodes
Wants=network-online.target
After=network-online.target xorg-headless.service oarbot_silver_helper_laptop_cd.service
Requires=xorg-headless.service

[Service]
Type=simple
User=oarbot_silver
ExecStart=/usr/local/bin/oarbot_silver_helper_laptop_launch.sh
Restart=on-failure
RestartSec=5

KillMode=control-group
TimeoutStopSec=10
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target