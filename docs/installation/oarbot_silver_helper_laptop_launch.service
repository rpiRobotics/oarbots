[Unit]
Description=Launch OARBot Silver ROS2 Nodes
Wants=network-online.target graphical.target
After=network-online.target graphical.target display-manager.service

[Service]
Type=simple
User=oarbot_silver
ExecStart=/home/oarbot_silver/ros2_ws/scripts/oarbot_silver_helper_laptop_launch.sh
Restart=on-failure
RestartSec=5

KillMode=control-group
TimeoutStopSec=10
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
